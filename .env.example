# Demo-safe defaults for Hearthkeep. Copy to .env only if you need local overrides.
# .env is git-ignored. Do not put real keys in this file.

HK_HOST=127.0.0.1
HK_PORT=8787
HK_DB=./data/hearthkeep.db
HK_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HK_SIM_MODE=1
HK_SIM_START=2026-10-21T09:00:00-07:00
# Demo-only mock confirmation code. Not a secret and not a real payment credential.
HK_PURCHASE_CODE=2468
HK_JSON_RESPONSE=0

# P1. Leave empty. The product runs with the deterministic planner when these are unset.
HK_AUTH_TOKEN=
HK_LLM_BASE_URL=
HK_LLM_API_KEY=
HK_LLM_MODEL=

# Video narration only. Never required to run or test the product. Leave empty.
DASHSCOPE_API_KEY=
